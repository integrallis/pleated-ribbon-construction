+// Experimental banding-phase hardware-counter probe (env PLEAT_PROFILE). Uses perf_event_open
+// self-monitoring (no sudo required when kernel.perf_event_paranoid <= 2) to scope cache-misses
+// and instructions to exactly the banding call, so pleat-on vs pleat-off memory behavior can be
+// compared directly. A no-op unless PLEAT_PROFILE is set. Not for production.
+class PleatBandingProfiler {
+ public:
+  explicit PleatBandingProfiler(size_t num_keys) : num_keys_(num_keys) {
+    static const bool kOn = (std::getenv("PLEAT_PROFILE") != nullptr);
+    enabled_ = kOn && num_keys > 4096;
+  }
+  void Start() {
+#if defined(__linux__)
+    if (!enabled_) return;
+    miss_fd_ = Open(PERF_COUNT_HW_CACHE_MISSES);
+    insn_fd_ = Open(PERF_COUNT_HW_INSTRUCTIONS);
+    Reset(miss_fd_);
+    Reset(insn_fd_);
+    Enable(miss_fd_);
+    Enable(insn_fd_);
+#endif
+  }
+  void StopAndReport() {
+#if defined(__linux__)
+    if (!enabled_) return;
+    Disable(miss_fd_);
+    Disable(insn_fd_);
+    uint64_t misses = Read(miss_fd_);
+    uint64_t insns = Read(insn_fd_);
+    if (miss_fd_ >= 0) close(miss_fd_);
+    if (insn_fd_ >= 0) close(insn_fd_);
+    std::fprintf(stderr,
+                 "PLEAT_PROFILE banding: keys=%zu cache_misses/key=%.4f instr/key=%.2f\n",
+                 num_keys_, static_cast<double>(misses) / num_keys_,
+                 static_cast<double>(insns) / num_keys_);
+#endif
+  }
+
+ private:
+  size_t num_keys_;
+  bool enabled_ = false;
+#if defined(__linux__)
+  int miss_fd_ = -1;
+  int insn_fd_ = -1;
+  static int Open(uint64_t config) {
+    struct perf_event_attr pea;
+    std::memset(&pea, 0, sizeof(pea));
+    pea.type = PERF_TYPE_HARDWARE;
+    pea.size = sizeof(pea);
+    pea.config = config;
+    pea.disabled = 1;
+    pea.exclude_kernel = 1;
+    pea.exclude_hv = 1;
+    return static_cast<int>(syscall(__NR_perf_event_open, &pea, 0, -1, -1, 0));
+  }
+  static void Reset(int fd) {
+    if (fd >= 0) ioctl(fd, PERF_EVENT_IOC_RESET, 0);
+  }
+  static void Enable(int fd) {
+    if (fd >= 0) ioctl(fd, PERF_EVENT_IOC_ENABLE, 0);
+  }
+  static void Disable(int fd) {
+    if (fd >= 0) ioctl(fd, PERF_EVENT_IOC_DISABLE, 0);
+  }
+  static uint64_t Read(int fd) {
+    uint64_t v = 0;
+    if (fd >= 0 && read(fd, &v, sizeof(v)) != sizeof(v)) v = 0;
+    return v;
+  }
+#endif
+};
